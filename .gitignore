# Local cache of fetched original game assets — never committed.
# Layout: original_files/<package_md5>/<original_filename>
/original_files/

# Per-release extraction output (named by package md5sum) — binaries,
# disassembly, polygon dumps, manifest. Always regenerable from the cache,
# never committed.
/work/

# Legacy per-release working directories at repo root (pre-refactor). Kept
# ignored so old extractions on disk don't pollute `git status`.
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/

# Legacy ad-hoc extraction scratch dir
/extract/

# Sibling-clone tool dependency (cloned by `make tools`, never vendored)
/AnotherWorld_VMTools/

# Generated docs data (regenerated from sessions/*.jsonl by tools/gen_docs_data.py)
/docs/data/

# Local-only archives of uncommitted scratch work (e.g. one-off backups
# of pre-existing extraction outputs preserved at project setup).
/cruft/

# Misc
*.pyc
__pycache__/
.DS_Store
*.cache
