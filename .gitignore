# Local PERMANENT ARCHIVE of fetched original game assets — never committed
# in this repo (the symlink to ../another-world-archive IS tracked, but the
# files reachable through it are not — they live in their own sibling repo).
# Layout: original_files/<slug>/<original_filename>  (resolves through symlink)
/original_files/

# Per-release extraction output (named by package md5sum) — binaries,
# disassembly, polygon dumps, manifest. Always regenerable from the cache,
# never committed.
/work/

# Legacy per-release working directories at repo root (pre-refactor). Kept
# ignored so old extractions on disk don't pollute `git status`.
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/

# Legacy ad-hoc extraction scratch dir
/extract/

# Sibling-clone tool dependency (cloned by `make tools`, never vendored)
/AnotherWorld_VMTools/

# Generated docs data (regenerated by tools/gen_docs_data.py)
/docs/data/

# Session transcripts moved to sibling repo another-world-session-logs.
# Re-add to .gitignore in case any local copies appear during rewrite/cleanup.
/sessions/

# Local-only archives of uncommitted scratch work (e.g. one-off backups
# of pre-existing extraction outputs preserved at project setup).
/cruft/

# Misc
*.pyc
__pycache__/
.DS_Store
*.cache
tmp/

# Local-only Claude Code session-state lock file (per-session, not durable)
/.claude/scheduled_tasks.lock

# Personal speculative working drafts (svg sketches, notes-in-progress)
/speculation/
